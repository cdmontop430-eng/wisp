DISCORD_TOKEN=your_bot_token_here
# Comma-separated Discord user IDs with full bot access.
OWNER_IDS=1414103455978618912,1434471542187884565
# Optional: restrict !ann to one channel. Leave blank to allow it in every channel.
ANNOUNCEMENT_CHANNEL_ID=
# Ignore identical announcements in the same channel during this window.
ANNOUNCEMENT_DEDUP_MS=600000
# Delay between member DMs in milliseconds; minimum is 250.
SENDALL_DELAY_MS=100
# Number of member DMs sent in parallel per batch.
SENDALL_CONCURRENCY=50
# Optional custom yt-dlp executable path. Default: tools/yt-dlp.exe
YTDLP_PATH=
